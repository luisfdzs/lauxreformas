# URL pública del entorno (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://lauxreformas.vercel.app
# "production" solo en el proyecto de prod: permite indexación en robots.txt
NEXT_PUBLIC_ENVIRONMENT=development

# Envío del formulario de presupuesto (Resend). Sin RESEND_API_KEY el formulario
# responde OK y solo registra la solicitud en los logs del servidor.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
